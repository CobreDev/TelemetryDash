<?xml version="1.0"?>
<!--
  Unraid container template for TelemetryDash.
  Copy to /boot/config/plugins/dockerMan/templates-user/my-telemetrydash.xml, then
  Docker tab > Add Container > Template: telemetrydash.
  The image is built by GitHub Actions on every push to main and published (privately) to
  GHCR, so Unraid needs `docker login ghcr.io` first; see the README.
-->
<Container version="2">
  <Name>telemetrydash</Name>
  <Repository>ghcr.io/cobredev/telemetrydash:latest</Repository>
  <Registry>https://github.com/CobreDev/TelemetryDash/pkgs/container/telemetrydash</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Overview>Live NASCAR race-stats dashboard (Cup, O'Reilly, Trucks) with a JSON API at /api/v1. Polls NASCAR's public live feed during sessions and keeps the current session in appdata.</Overview>
  <Category>Tools: Other:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <!-- Served by the container itself (the repo and image are private, so no public URL).
       Unraid fetches it from the host; change 8099 if you map a different port. -->
  <Icon>http://127.0.0.1:8099/icon.png</Icon>
  <!-- Run as nobody:users so files in appdata get Unraid's usual owner. -->
  <ExtraParams>--user 99:100 --restart unless-stopped</ExtraParams>
  <Config Name="Web UI port" Target="8080" Default="8099" Mode="tcp" Description="Port for the dashboard and API" Type="Port" Display="always" Required="true" Mask="false">8099</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/telemetrydash" Mode="rw" Description="Cached NASCAR files and the live session (survives restarts)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/telemetrydash</Config>
  <Config Name="Time zone" Target="TZ" Default="America/New_York" Mode="" Description="Container time zone (logs only; race times are handled in ET regardless)" Type="Variable" Display="advanced" Required="false" Mask="false">America/New_York</Config>
</Container>
